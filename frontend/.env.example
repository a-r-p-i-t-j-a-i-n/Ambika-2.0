# ─────────────────────────────────────────────────────────────────
# Copy this file to `.env` (dev) or set these as platform env vars
# in your hosting provider (Vercel / Netlify / Cloudflare Pages).
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here.
# ─────────────────────────────────────────────────────────────────

# Base URL of the backend API.
# • Dev:               http://localhost:5000/api/v1
# • Same-origin prod:  /api/v1
# • Cross-origin prod: https://api.example.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
