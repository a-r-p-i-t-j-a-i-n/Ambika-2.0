# Static asset cache + basic security headers (Netlify / Cloudflare Pages).

# Long-lived cache for hashed JS / CSS / fonts.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the SPA shell — it must always pick up the newest asset hashes.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Update poller — must never be cached, or clients won't see new deploys.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Baseline security headers.
# Framing: only this site and the Delegation Suite (which shows the ERP screens
# inside its own sidebar) may frame this app. Microphone is allowed for this
# origin so the voice recorder works.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://msambika.netlify.app
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(self), camera=()
