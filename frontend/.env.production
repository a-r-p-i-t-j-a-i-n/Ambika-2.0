# ─────────────────────────────────────────────────────────────────
# Production build environment
#
# Same-origin deployment: the frontend is served from the same host
# as the backend, so the API lives at the relative path /api/v1.
# This makes CORS a non-issue and lets the same build work behind
# any reverse proxy (nginx, Cloudflare, Vercel rewrites, etc).
#
# If you ever split the frontend onto its own domain, change this
# to the absolute API URL (e.g. https://api.ambika.com/api/v1).
# ─────────────────────────────────────────────────────────────────

VITE_API_URL=/api/v1
