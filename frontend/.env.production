# ─────────────────────────────────────────────────────────────────
# Production build environment
#
# Backend is deployed on Render at https://o2d.onrender.com
# (different origin from the frontend), so we point to the absolute
# API URL. CORS is already open on the backend (`cors({ origin: '*' })`),
# so no extra wiring is needed.
#
# If you ever move both behind the same domain, switch this back to
# the relative path "/api/v1".
# ─────────────────────────────────────────────────────────────────

VITE_API_URL=https://o2d.onrender.com/api/v1
