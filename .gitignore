# SSH deploy keys — never commit
*.pem
*.key

# Holds real production credentials — scp it to the server, never commit it
deploy/server.env.template

# ---------------------------------------------------------------
# Local dev / generated artefacts (added for a clean, Git-safe setup)
# ---------------------------------------------------------------

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Git-Bash crash dumps (bash.exe.stackdump is currently tracked - see report)
*.stackdump

# Runtime uploads written by the backend (express.static serves ./uploads
# relative to process.cwd()). The leading slash is REQUIRED: an unanchored
# "uploads/" would also match backend/src/common/uploads/, which is SOURCE
# CODE that app.js imports. Same trap the rsync excludes in deploy.yml warn about.
/backend/uploads/
/uploads/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/

# Vite cache
.vite/

.excel
