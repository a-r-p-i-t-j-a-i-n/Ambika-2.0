# =================================================================
# Backend environment template - dpes-backend
#
# Copy this file to `.env` in THIS directory (backend/.env) and fill
# in the values. `.env` is git-ignored; this template is committed.
#
#     cp .env.example .env        (Git Bash)
#     copy .env.example .env      (cmd)
#
# Every variable below has a fallback in src/config/env.js, so the
# server boots without a .env - but it would then use
# JWT_SECRET='fallback-secret' and a local database. Do not do that.
#
# NEVER put real credentials in this file.
# =================================================================

# ---- Core (required) --------------------------------------------
NODE_ENV=development
# Port the API listens on. The frontend dev server assumes 5000; if you
# change it, also set VITE_API_URL in frontend/.env to match.
PORT=5000
# Local MongoDB:  mongodb://127.0.0.1:27017/dpes_agl
# Atlas:          mongodb+srv://<user>:<password>@<cluster>/<db>
#
# MUST BE A REPLICA SET (Atlas always is; a plain `mongod` is not).
# Posting QC-accepted stock writes the inventory movements, the balances, the
# GRN line markers and the QC completion as ONE unit, and MongoDB only offers
# transactions on a replica set. Without one the server REFUSES to post (503,
# "...has to be written as one unit...") rather than writing part of it — so
# Incoming QC cannot be completed at all on a standalone mongod.
#
# For local development and staging, a single-node replica set is enough:
#     mongod --replSet rs0 --dbpath <data dir>
#     mongosh --eval 'rs.initiate()'          (once)
#     MONGO_URI=mongodb://127.0.0.1:27017/dpes_agl?replicaSet=rs0&directConnection=true
#
# INVENTORY_ALLOW_NON_ATOMIC=true turns the refusal back into the old
# write-anyway behaviour. It exists for throwaway test databases (the e2e
# harness sets it for itself) and must NEVER be set where real stock is kept:
# a failure part-way then leaves some lines posted and the rest not.
MONGO_URI=
# Any long random string for local dev. Must NOT be shared with production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Single sign-on from the Delegation Suite (ERP screens shown inside it). Must be
# the SAME value as ERP_SSO_SECRET on the Suite backend; 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave blank to turn single sign-on off (POST /auth/sso then answers 503).
ERP_SSO_SECRET=

# ---- Company identity (optional) --------------------------------
# Printed on generated PDFs and emails. Falls back to the values in
# src/config/env.js when omitted.
COMPANY_NAME=
COMPANY_CODE=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=

# ---- Absolute URLs used in outbound links (optional) ------------
# Only needed for links inside emails / PDFs. Defaults:
#   SERVER_URL -> http://localhost:<PORT>
#   CLIENT_URL -> http://localhost:3000
SERVER_URL=
CLIENT_URL=
FRONTEND_URL=

# ---- Email (optional) -------------------------------------------
# Used by the O2D SLA-breach escalation job and approval notifications.
# Leave blank locally: emails are simply not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Brevo HTTP API key - alternative to SMTP when ports are blocked.
BREVO_API_KEY=

# ---- File uploads / AWS S3 (optional) ---------------------------
# S3 turns on only when ALL FOUR of the first vars below are set.
# Leave them blank locally: uploads are written to backend/uploads/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_PREFIX=

# ---- Feature toggles (optional) ---------------------------------
# Set to "off" to skip the recurring SLA-escalation job on boot.
O2D_FMS_ESCALATION=
O2D_ACTIVE_FMS=

# ---- Rate limiting (optional) -----------------------------------
# The limiter is currently commented out in src/app.js; these are read
# by src/config/env.js only.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
